{
  "name": "mahjong-layout-tool",
  "private": true,
  "version": "0.0.0",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:iishanten": "vite build --ssr src/utils/iishanten.ts --outDir .tmp-iishanten-test && node scripts/test-iishanten.mjs",
    "test:melds": "vite build --ssr src/utils/detectMelds.ts --outDir .tmp-detect-melds-test && node scripts/test-detect-melds.mjs",
    "test:expected-value": "vite build --ssr src/utils/expectedValue.ts --outDir .tmp-expected-value-test && node scripts/test-expected-value.mjs"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "jspdf": "^3.0.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
